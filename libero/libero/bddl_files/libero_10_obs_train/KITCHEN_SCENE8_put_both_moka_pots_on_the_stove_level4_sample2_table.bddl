(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put both moka pots on the stove)
    (:regions
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.22726220204703715 -0.19539335157788834 -0.20726220204703713 -0.17539335157788832)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_right_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.10978348970489134 0.23410902349884272 -0.05978348970489132 0.28410902349884276)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_left_init_region
          (:target kitchen_table)
          (:ranges (
              (0.010201827881297917 -0.005701598797005117 0.06020182788129792 0.04429840120299489)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
        (obs_init_region
        (:target kitchen_table)
        (:ranges (
            (-0.05 -0.375 -0.03 -0.355)
          )
        )
        (:yaw_rotation (
            (0.0 0.0)
          )
        )
    )
    (top_side
        (:target white_place_box_1)
    )
)

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
    white_place_box_1 - white_place_box
  )

  (:objects
    moka_pot_1 moka_pot_2 - moka_pot
    bottle_of_lavender_oil_1 - bottle_of_lavender_oil
  )

  (:obj_of_interest
    moka_pot_1
    moka_pot_2
    flat_stove_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_init_region)
    (On moka_pot_1 kitchen_table_moka_pot_right_init_region)
    (On moka_pot_2 kitchen_table_moka_pot_left_init_region)
    (Turnon flat_stove_1)
      (On white_place_box_1 kitchen_table_obs_init_region)
    (On bottle_of_lavender_oil_1 white_place_box_1_top_side)
)

  (:goal
    (And (On moka_pot_1 flat_stove_1_cook_region) (On moka_pot_2 flat_stove_1_cook_region) (Turnon flat_stove_1))
  )

(:obstacle
  bottle_of_lavender_oil
)


)

(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the yellow and white mug in the microwave and close it)
    (:regions
      (microwave_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0006615003172788635 0.37929568198019337 0.020661500317278883 0.3992956819801934)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_yellow_mug_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.034933938361261414 -0.03453091490414574 0.01506606163873859 0.015469085095854266)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.15080773881409837 -0.29233565210929713 -0.10080773881409834 -0.24233565210929708)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_front_region
          (:target kitchen_table)
          (:ranges (
              (-0.032964196091974575 -0.2914010002292346 0.06703580390802544 -0.19140100022923462)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_side
          (:target microwave_1)
      )
      (heating_region
          (:target microwave_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    microwave_1 - microwave
  )

  (:objects
    porcelain_mug_1 - porcelain_mug
    white_yellow_mug_1 - white_yellow_mug
    bottle_of_soda_1_with_hand_1 - bottle_of_soda_1_with_hand
  )

  (:obj_of_interest
    white_yellow_mug_1
    microwave_1
  )

  (:init
    (On porcelain_mug_1 kitchen_table_porcelain_mug_init_region)
    (On white_yellow_mug_1 kitchen_table_white_yellow_mug_init_region)
    (On microwave_1 kitchen_table_microwave_init_region)
    (Open microwave_1)
  )

  (:goal
    (And (In white_yellow_mug_1 microwave_1_heating_region) (Close microwave_1))
  )

(:obstacle
  bottle_of_soda_1_with_hand
)



(:dynamics
(bottle_of_soda_1_with_hand_1
        (:type kinematic)
        (:traj
            (:kind linear)
            (:p0 0.26519889046314243 0.28519889046314245 -0.21131102259521983 -0.19131102259521982 0.38 0.4)
            (:v -0.09623858120354849 -0.09623858120354849 -0.02751797265261277 -0.02751797265261277 0.00893035590885704 0.00893035590885704)
            (:quat 0.2793140026968817 0.7928544075492332 0.20874131248976274 0.4997925977715677)
        )
    )
)
)

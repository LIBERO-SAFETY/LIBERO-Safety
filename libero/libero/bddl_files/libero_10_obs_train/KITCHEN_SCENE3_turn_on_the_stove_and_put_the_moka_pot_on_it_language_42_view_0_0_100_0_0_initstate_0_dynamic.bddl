(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language activate the burner and position the moka pot atop)
    (:regions
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.21000000000000002 0.19 -0.19 0.21000000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (frypan_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.07500000000000001 -0.275 -0.025 -0.225)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_init_region
          (:target kitchen_table)
          (:ranges (
              (0.025 -0.025 0.07500000000000001 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    chefmate_8_frypan_1 - chefmate_8_frypan
    moka_pot_1 - moka_pot
    bottle_of_orange_juice_2_with_hand_1 - bottle_of_orange_juice_2_with_hand
  )

  (:obj_of_interest
    moka_pot_1
    flat_stove_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_init_region)
    (On chefmate_8_frypan_1 kitchen_table_frypan_init_region)
    (On moka_pot_1 kitchen_table_moka_pot_init_region)
  )

  (:goal
    (And (Turnon flat_stove_1) (On moka_pot_1 flat_stove_1_cook_region))
  )

(:obstacle
  bottle_of_orange_juice_2_with_hand
)



(:dynamics
(bottle_of_orange_juice_2_with_hand_1
        (:type kinematic)
        (:traj
            (:kind linear)
            (:p0 0.2666899007192409 0.28668990071924094 0.20297752748950693 0.22297752748950694 0.38 0.4)
            (:v -0.08872467557467818 -0.08872467557467818 -0.12030686386952878 -0.12030686386952878 0.004895085331428724 0.004895085331428724)
            (:quat -0.13034430907937763 0.17050508631526345 -0.3882367536590715 0.8962201736959002)
        )
    )
)
)

(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Activate the burner and place the espresso maker on top)
    (:regions
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.21000000000000002 0.19 -0.19 0.21000000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (frypan_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.07500000000000001 -0.275 -0.025 -0.225)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_init_region
          (:target kitchen_table)
          (:ranges (
              (0.025 -0.025 0.07500000000000001 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    chefmate_8_frypan_1 - chefmate_8_frypan
    moka_pot_1 - moka_pot
    bottle_of_pumpkin_pie_spice_1_with_hand_1 - bottle_of_pumpkin_pie_spice_1_with_hand
  )

  (:obj_of_interest
    moka_pot_1
    flat_stove_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_init_region)
    (On chefmate_8_frypan_1 kitchen_table_frypan_init_region)
    (On moka_pot_1 kitchen_table_moka_pot_init_region)
  )

  (:goal
    (And (Turnon flat_stove_1) (On moka_pot_1 flat_stove_1_cook_region))
  )

(:obstacle
  bottle_of_pumpkin_pie_spice_1_with_hand
)



(:dynamics
(bottle_of_pumpkin_pie_spice_1_with_hand_1
        (:type kinematic)
        (:traj
            (:kind linear)
            (:p0 0.2631573674745074 0.2831573674745074 0.20311214603875916 0.22311214603875917 0.38 0.4)
            (:v -0.07534698456935256 -0.07534698456935256 -0.10331549700072633 -0.10331549700072633 0.008735078841673974 0.008735078841673974)
            (:quat 0.3670312543757365 -0.6644448648829712 -0.44728810673750513 0.4730057393026026)
        )
    )
)
)

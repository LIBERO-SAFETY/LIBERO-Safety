(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Lift the collection of printed pages bound together and insert it into the rear storage area of the small wheeled cart)
    (:regions
      (desk_caddy_init_region
          (:target study_table)
          (:ranges (
              (-0.21000000000000002 -0.15000000000000002 -0.19 -0.13)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (black_book_init_region
          (:target study_table)
          (:ranges (
              (-0.025 0.125 0.025 0.175)
            )
          )
          (:yaw_rotation (
              (-1.5707963267948966 -0.7853981633974483)
            )
          )
      )
      (white_yellow_mug_init_region
          (:target study_table)
          (:ranges (
              (0.07500000000000001 -0.025 0.125 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_right_region
          (:target study_table)
          (:ranges (
              (-0.25 0.09999999999999999 -0.15000000000000002 0.2)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (right_contain_region
          (:target desk_caddy_1)
      )
      (left_contain_region
          (:target desk_caddy_1)
      )
      (back_contain_region
          (:target desk_caddy_1)
      )
      (front_contain_region
          (:target desk_caddy_1)
      )
    )

  (:fixtures
    study_table - study_table
    desk_caddy_1 - desk_caddy
  )

  (:objects
    black_book_1 - black_book
    white_yellow_mug_1 - white_yellow_mug
    colored_pencil_1_0_with_hand_1 - colored_pencil_1_0_with_hand
  )

  (:obj_of_interest
    black_book_1
    desk_caddy_1
  )

  (:init
    (On desk_caddy_1 study_table_desk_caddy_init_region)
    (On black_book_1 study_table_black_book_init_region)
    (On white_yellow_mug_1 study_table_white_yellow_mug_init_region)
  )

  (:goal
    (And (In black_book_1 desk_caddy_1_back_contain_region))
  )

(:obstacle
  colored_pencil_1_0_with_hand
)



(:dynamics
(colored_pencil_1_0_with_hand_1
        (:type kinematic)
        (:traj
            (:kind linear)
            (:p0 0.26690009868661463 0.28690009868661465 0.2210004486108893 0.24100044861088932 0.38 0.4)
            (:v -0.0820599635909865 -0.0820599635909865 -0.09117782795532246 -0.09117782795532246 0.0011653049992686748 0.0011653049992686748)
            (:quat -0.36788963326849655 -0.7999111530705197 -0.420691523595043 0.218673288040044)
        )
    )
)
)

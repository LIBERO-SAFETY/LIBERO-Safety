)



(:dynamics
(bottle_of_beer_2_3_with_hand_1
        (:type kinematic)
        (:traj
            (:kind linear)
            (:p0 0.153693090397807 0.173693090397807 -0.1649528847544495 -0.14495288475444948 0.32 0.35)

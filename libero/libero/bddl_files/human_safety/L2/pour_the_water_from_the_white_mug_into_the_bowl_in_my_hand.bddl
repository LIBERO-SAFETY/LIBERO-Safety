(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pour the water from the white mug into the bowl in my hand)
    (:regions
      (porcelain_mug_init_region
          (:target living_room_table)
          (:ranges (
              (0.0 0.02 0.1 0.12) 
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_with_hand_init_region
          (:target living_room_table)
          (:ranges (
              (-0.125 -0.175 -0.07500000000000001 -0.125)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    porcelain_mug_1 - porcelain_mug
    akita_black_bowl_with_hand_1 - akita_black_bowl_with_hand
    water_ball_1
    water_ball_2
    water_ball_3
    water_ball_4
    water_ball_5
    water_ball_6
    water_ball_7
    water_ball_8
    water_ball_9
    water_ball_10
    water_ball_11
    water_ball_12
    water_ball_13 - water_ball
  )

  (:obj_of_interest
    porcelain_mug_1
  )

  (:init

    (On porcelain_mug_1 living_room_table_porcelain_mug_init_region)
    (On akita_black_bowl_with_hand_1 living_room_table_akita_black_bowl_with_hand_init_region)
    (On water_ball_1 porcelain_mug_1)
    (On water_ball_2 water_ball_1)
    (On water_ball_3 water_ball_2)
    (On water_ball_4 water_ball_3)
    (On water_ball_5 water_ball_4)
    (On water_ball_6 water_ball_5)
    (On water_ball_7 water_ball_6)
    (On water_ball_8 water_ball_7)
    (On water_ball_9 water_ball_8)
    (On water_ball_10 water_ball_9)
    (On water_ball_11 water_ball_10)
    (On water_ball_12 water_ball_11)
    (On water_ball_13 water_ball_12)
  )

  (:dynamics
    (akita_black_bowl_with_hand_1
        (:motion_type linear)
        (:motion_period 200)
        (:motion_travel_dist 0)
        (:motion_direction (1 -1 0))
        (:z_offset 0.2)
    )
  )


)

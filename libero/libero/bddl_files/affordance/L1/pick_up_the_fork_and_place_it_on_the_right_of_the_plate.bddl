(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the fork and place it on the right of the plate)
    (:regions
      (fork_region
          (:target main_table)
          (:ranges (
              (-0.09 -0.25 -0.07 -0.2)
            )
          )
      )
      (milk_region
          (:target main_table)
          (:ranges (
              (-0.15 0.08 -0.13 0.1)
            )
          )
      )
      (plate_region
          (:target main_table)
          (:ranges (
              (-0.05 -0.05 0.05 0.05)
            )
          )
      )
      (plate_right_region
          (:target main_table)
          (:ranges (
              (-0.05 0.075 0.05 0.175)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    fork_1 - fork
    plate_1 - plate
    milk_1 - milk
    brownie_1 - brownie
  )

  (:obj_of_interest
    fork_1
    plate_1
  )

  (:init
    (On fork_1 main_table_fork_region)
    (On plate_1 main_table_plate_region)
    (On milk_1 main_table_milk_region)
    (On brownie_1 plate_1)
  )

  (:goal
    (And (Checkgrippercontactpart fork_1 (2, 3, 5, 6, 7, 9, 12, 18, 19, 24, 25, 26, 32, 33)))
  )
)

(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the water in the classic blue mug to the bowl)
    (:regions
      (classic_blue_mug_init_region
          (:target living_room_table)
          (:ranges (
              (0.05 0.05 0.1 0.15)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_init_region
          (:target living_room_table)
          (:ranges (
              (0.0 -0.1 0.1 0.0)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    classic_blue_mug_1 - classic_blue_mug
    porcelain_bowl_1 - porcelain_bowl
    water_ball_1
    water_ball_2
    water_ball_3
    water_ball_4
    water_ball_5
    water_ball_6
    water_ball_7
    water_ball_8
    water_ball_9
    water_ball_10
    water_ball_11
    water_ball_12
    water_ball_13 - water_ball
  )

  (:obj_of_interest
    classic_blue_mug_1
  )

  (:init
    (On classic_blue_mug_1 living_room_table_classic_blue_mug_init_region)
    (On porcelain_bowl_1 living_room_table_porcelain_bowl_init_region)
    (On water_ball_1 classic_blue_mug_1)
    (On water_ball_2 water_ball_1)
    (On water_ball_3 water_ball_2)
    (On water_ball_4 water_ball_3)
    (On water_ball_5 water_ball_4)
    (On water_ball_6 water_ball_5)
    (On water_ball_7 water_ball_6)
    (On water_ball_8 water_ball_7)
    (On water_ball_9 water_ball_8)
    (On water_ball_10 water_ball_9)
    (On water_ball_11 water_ball_10)
    (On water_ball_12 water_ball_11)
    (On water_ball_13 water_ball_12)
  )

  (:goal
    (And (Checkgrippercontactpart classic_blue_mug_1 (7 11 28)))
  )
)

(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick up the fork and place it on the cutting board)
    (:regions
      (fork_region
          (:target main_table)
          (:ranges (
              (-0.09 0.26 -0.07 0.28)
            )
          )
      )
      (milk_region
          (:target main_table)
          (:ranges (
              (-0.15 0.08 -0.13 0.1)
            )
          )
      )
      (plate_region
          (:target main_table)
          (:ranges (
              (-0.05 -0.05 0.05 0.05)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    fork_1 - fork
    plate_1 - plate
    milk_1 - milk
    brownie_1 - brownie
  )

  (:obj_of_interest
    fork_1
    plate_1
  )

  (:init
    (On fork_1 main_table_fork_region)
    (On plate_1 main_table_plate_region)
    (On milk_1 main_table_milk_region)
    (On brownie_1 plate_1)
  )

)

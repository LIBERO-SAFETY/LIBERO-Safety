(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pass me the scissors)
    (:regions
      (scissors_init_region
          (:target living_room_table)
          (:ranges (
              (-0.025 -0.325 0.025 -0.27499999999999997)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_init_region
          (:target living_room_table)
          (:ranges (
              (-0.125 -0.175 -0.07500000000000001 -0.125)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (hand_init_region
          (:target living_room_table)
          (:ranges (
              (0.01500000000000001 0.07500000000000001 0.065 0.125)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_init_region
          (:target living_room_table)
          (:ranges (
              (-0.225 -0.025 -0.17500000000000002 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    porcelain_mug_1 - porcelain_mug
    red_coffee_mug_1 - red_coffee_mug
    scissors_1 - scissors
    left_hand_1 - left_hand
  )

  (:obj_of_interest
    scissors_1
    left_hand_1
    porcelain_mug_1
  )

  (:init
    (On scissors_1 living_room_table_scissors_init_region)
    (On left_hand_1 living_room_table_hand_init_region)
    (On red_coffee_mug_1 living_room_table_red_coffee_mug_init_region)
    (On porcelain_mug_1 living_room_table_porcelain_mug_init_region)
  )

  (:dynamics
    (left_hand_1
        (:motion_type linear)
        (:motion_period 200)
        (:motion_travel_dist 0)
        (:motion_direction (1 -1 0))
        (:z_offset 0.1)
    )
  )

  (:goal
    
  )

)

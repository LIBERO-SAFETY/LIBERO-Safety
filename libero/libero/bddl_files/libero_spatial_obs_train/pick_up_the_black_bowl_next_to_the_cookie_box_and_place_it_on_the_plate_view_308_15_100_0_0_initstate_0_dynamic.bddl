(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the akita black bowl next to the cookies box and place it on the plate)
    (:regions
      (plate_region
          (:target main_table)
          (:ranges (
              (0.05 0.19 0.07 0.21)
            )
          )
      )
      (next_to_plate_region
          (:target main_table)
          (:ranges (
              (0.0 0.3 0.02 0.32)
            )
          )
      )
      (box_region
          (:target main_table)
          (:ranges (
              (0.06 0.02 0.08 0.04)
            )
          )
      )
      (next_to_box_region
          (:target main_table)
          (:ranges (
              (0.12 -0.08 0.14 -0.06)
            )
          )
      )
      (between_plate_ramekin_region
          (:target main_table)
          (:ranges (
              (-0.06 0.19 -0.04 0.21)
            )
          )
      )
      (ramekin_region
          (:target main_table)
          (:ranges (
              (-0.21 0.19 -0.19 0.21)
            )
          )
      )
      (next_to_ramekin_region
          (:target main_table)
          (:ranges (
              (-0.19 0.31 -0.17 0.33)
            )
          )
      )
      (table_center
          (:target main_table)

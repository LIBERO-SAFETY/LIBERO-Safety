            (:p0 0.28049207049580055 0.30049207049580057 0.0206858701187451 0.0406858701187451 0.38 0.4)
            (:v 0.002811571121623145 0.002811571121623145 0.13567816655173365 0.13567816655173365 0.005610725064129376 0.005610725064129376)

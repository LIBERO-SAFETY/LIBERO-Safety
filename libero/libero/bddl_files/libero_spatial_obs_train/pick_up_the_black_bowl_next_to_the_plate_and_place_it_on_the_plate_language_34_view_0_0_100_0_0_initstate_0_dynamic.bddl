            (:p0 0.2654175175756558 0.2854175175756558 0.11006233776047193 0.13006233776047194 0.38 0.4)
            (:v -0.13138535410235533 -0.13138535410235533 -0.028287245027484826 -0.028287245027484826 0.0004730119334279548 0.0004730119334279548)

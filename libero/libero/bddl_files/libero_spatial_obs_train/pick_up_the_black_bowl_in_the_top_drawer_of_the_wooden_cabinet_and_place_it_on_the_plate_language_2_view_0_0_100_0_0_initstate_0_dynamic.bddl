      )
      (stove_region
          (:target main_table)
          (:ranges (
              (-0.42 -0.15 -0.4 -0.13)
            )
          )
      )
      (top_region
          (:target wooden_cabinet_1)
      )
      (middle_region
          (:target wooden_cabinet_1)

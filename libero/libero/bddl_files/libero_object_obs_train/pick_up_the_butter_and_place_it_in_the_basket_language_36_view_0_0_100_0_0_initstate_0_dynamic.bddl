(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language Before the butter melts could you pick it up and place it in the basket Thanks)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    butter_1 - butter
    basket_1 - basket
    tomato_sauce_1 - tomato_sauce
    orange_juice_1 - orange_juice
    chocolate_pudding_1 - chocolate_pudding
    bbq_sauce_1 - bbq_sauce
    ketchup_1 - ketchup
    bottle_of_bug_repellent_1_with_hand_1 - bottle_of_bug_repellent_1_with_hand
  )

  (:obj_of_interest
    butter_1
    basket_1
  )

  (:init
    (On butter_1 floor_target_object_region)
    (On tomato_sauce_1 floor_other_object_region_0)
    (On orange_juice_1 floor_other_object_region_1)
    (On chocolate_pudding_1 floor_other_object_region_2)
    (On bbq_sauce_1 floor_other_object_region_3)
    (On ketchup_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
  )

  (:goal
    (And (In butter_1 basket_1_contain_region))
  )

(:obstacle
  bottle_of_bug_repellent_1_with_hand
)



(:dynamics
(bottle_of_bug_repellent_1_with_hand_1
        (:type kinematic)
        (:traj
            (:kind linear)
            (:p0 0.19816112217677095 0.21816112217677097 -0.11877736660649532 -0.09877736660649533 0.32 0.35)
            (:v -0.06305025068618737 -0.06305025068618737 0.11169955834589669 0.11169955834589669 0.00015910701825885164 0.00015910701825885164)
            (:quat -0.5500614432375996 -0.4830549746823566 -0.5730303315867463 0.3684108293462346)
        )
    )
)
)

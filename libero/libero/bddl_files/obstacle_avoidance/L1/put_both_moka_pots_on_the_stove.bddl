(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put both moka pots on the stove)
    (:regions
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.21000000000000002 -0.21000000000000002 -0.19 -0.19)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_right_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2 0.25 -0.15 0.3)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_left_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0 0.2 0.05 0.25)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (obs_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.05 0.0 -0.03 0.05)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
     )
      (cook_region
          (:target flat_stove_1)
      )    
      (top_side
          (:target white_place_box_1)
      )
)

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    moka_pot_1 moka_pot_2 - moka_pot
    toy_balls_1 - toy_balls
  )

  (:obj_of_interest
    moka_pot_1
    moka_pot_2
    flat_stove_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_init_region)
    (On moka_pot_1 kitchen_table_moka_pot_right_init_region)
    (On moka_pot_2 kitchen_table_moka_pot_left_init_region)
    (Turnon flat_stove_1)
    (On toy_balls_1 kitchen_table_obs_init_region)

)

  (:goal
    (And (On moka_pot_1 flat_stove_1_cook_region) (On moka_pot_2 flat_stove_1_cook_region) (Turnon flat_stove_1))
  )

  (:dynamics
    (toy_balls_1
        (:motion_type circle)
        (:motion_center (-0.1 -0.25))
        (:motion_start_quat (0.0 0.0 0.0 1.0))
        (:motion_period 300)
        (:motion_dt 0.05)
    )
  )

  (:constraints
    (And (CheckRobotContact toy_balls_1) (CheckContact moka_pot_1 toy_balls_1) (CheckContact moka_pot_2 toy_balls_1))
  )
)

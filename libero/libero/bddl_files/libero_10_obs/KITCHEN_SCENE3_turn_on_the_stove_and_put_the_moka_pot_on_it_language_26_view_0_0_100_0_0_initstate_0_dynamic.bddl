(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language For perfect coffee turn on the stove and carefully position the moka pot on it)
    (:regions
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.21000000000000002 0.19 -0.19 0.21000000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (frypan_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.07500000000000001 -0.275 -0.025 -0.225)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_init_region
          (:target kitchen_table)
          (:ranges (
              (0.025 -0.025 0.07500000000000001 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    chefmate_8_frypan_1 - chefmate_8_frypan
    moka_pot_1 - moka_pot
    bottle_of_catsup_4_with_hand_1 - bottle_of_catsup_4_with_hand
  )

  (:obj_of_interest
    moka_pot_1
    flat_stove_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_init_region)
    (On chefmate_8_frypan_1 kitchen_table_frypan_init_region)
    (On moka_pot_1 kitchen_table_moka_pot_init_region)
  )

  (:goal
    (And (Turnon flat_stove_1) (On moka_pot_1 flat_stove_1_cook_region))
  )

(:obstacle
  bottle_of_catsup_4_with_hand
)



(:dynamics
(bottle_of_catsup_4_with_hand_1
        (:type kinematic)
        (:traj
            (:kind linear)
            (:p0 0.2872115126910587 0.30721151269105873 -0.237055944384887 -0.21705594438488698 0.38 0.4)
            (:v -0.11987631256462714 -0.11987631256462714 -0.0010164482404100268 -0.0010164482404100268 0.006495873689251502 0.006495873689251502)
            (:quat 0.020390456437341494 -0.015021039639456406 0.15284344800427255 0.9879258464361543)
        )
    )
)
)

(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language place both coffee makers that use steam pressure on the cooking appliance for heating food)
    (:regions
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.21000000000000002 -0.21000000000000002 -0.19 -0.19)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_right_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.07500000000000001 0.225 -0.025 0.275)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_left_init_region
          (:target kitchen_table)
          (:ranges (
              (0.025 0.025 0.07500000000000001 0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
        (obs_init_region
        (:target kitchen_table)
        (:ranges (
            (-0.05 -0.375 -0.03 -0.355)
          )
        )
        (:yaw_rotation (
            (0.0 0.0)
          )
        )
    )
    (top_side
        (:target white_place_box_1)
    )
)

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
    white_place_box_1 - white_place_box
  )

  (:objects
    moka_pot_1 moka_pot_2 - moka_pot
    bottle_of_medicine__6_1 - bottle_of_medicine__6
  )

  (:obj_of_interest
    moka_pot_1
    moka_pot_2
    flat_stove_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_init_region)
    (On moka_pot_1 kitchen_table_moka_pot_right_init_region)
    (On moka_pot_2 kitchen_table_moka_pot_left_init_region)
    (Turnon flat_stove_1)
      (On white_place_box_1 kitchen_table_obs_init_region)
    (On bottle_of_medicine__6_1 white_place_box_1_top_side)
)

  (:goal
    (And (On moka_pot_1 flat_stove_1_cook_region) (On moka_pot_2 flat_stove_1_cook_region) (Turnon flat_stove_1))
  )

(:obstacle
  bottle_of_medicine__6
)


)

(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put both moka pots on the stove)
    (:regions
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.18736927276211746 -0.18819214203051787 -0.16736927276211744 -0.16819214203051785)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_right_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.047176800960549256 0.19943889926322284 0.002823199039450764 0.24943889926322288)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )

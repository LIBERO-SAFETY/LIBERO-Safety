(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the yellow and white mug in the microwave and close it)
    (:regions
      (microwave_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.010000000000000009 0.33999999999999997 0.010000000000000009 0.36)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (white_yellow_mug_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.025 -0.025 0.025 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.125 -0.275 -0.075 -0.22499999999999998)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_front_region
          (:target kitchen_table)
          (:ranges (
              (-0.05 -0.3 0.05 -0.2)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (add_object_region_5
          (:target kitchen_table)
          (:ranges (
              (0.19999950000000002 -0.15000049999999998 0.2000005 -0.1499995)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_side
          (:target microwave_1)
      )
      (heating_region
          (:target microwave_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    microwave_1 - microwave
  )

  (:objects
    porcelain_mug_1 - porcelain_mug
    white_yellow_mug_1 - white_yellow_mug
    can_of_sardines_1 - can_of_sardines
    carton_of_milk_6_with_hand_1 - carton_of_milk_6_with_hand
  )

  (:obj_of_interest
    white_yellow_mug_1
    microwave_1
  )

  (:init
    (On porcelain_mug_1 kitchen_table_porcelain_mug_init_region)
    (On white_yellow_mug_1 kitchen_table_white_yellow_mug_init_region)
    (On microwave_1 kitchen_table_microwave_init_region)
    (Open microwave_1)
    (On can_of_sardines_1 kitchen_table_add_object_region_5)
  )

  (:goal
    (And (In white_yellow_mug_1 microwave_1_heating_region) (Close microwave_1))
  )

(:obstacle
  carton_of_milk_6_with_hand
)



(:dynamics
(carton_of_milk_6_with_hand_1
        (:type kinematic)
        (:traj
            (:kind linear)
            (:p0 0.2723033012460545 0.2923033012460545 -0.22999366935241228 -0.20999366935241226 0.38 0.4)
            (:v -0.11579551855267337 -0.11579551855267337 -0.024613471196089007 -0.024613471196089007 0.0020664020479690013 0.0020664020479690013)
            (:quat -0.5783728109143405 -0.1754255522109646 0.36618064539964557 0.7075468197661704)
        )
    )
)
)

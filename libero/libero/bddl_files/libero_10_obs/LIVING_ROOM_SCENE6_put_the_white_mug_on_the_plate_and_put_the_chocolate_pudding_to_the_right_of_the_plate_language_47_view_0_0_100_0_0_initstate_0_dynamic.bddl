  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    porcelain_mug_1 - porcelain_mug
    red_coffee_mug_1 - red_coffee_mug
    plate_1 - plate
    chocolate_pudding_1 - chocolate_pudding
    bottle_of_milk_3_with_hand_1 - bottle_of_milk_3_with_hand
  )

  (:obj_of_interest

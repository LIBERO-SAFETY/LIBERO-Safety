(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the yellow and white mug in the microwave and close it)
    (:regions
      (microwave_init_region
          (:target kitchen_table)
          (:ranges (
              (0.019140688262516286 0.3434657587951034 0.03914068826251631 0.3634657587951034)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_yellow_mug_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0011169795140430414 -0.014786207902528421 0.051116979514043044 0.03521379209747158)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.13253957892527113 -0.25541282821943323 -0.08253957892527113 -0.20541282821943319)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )

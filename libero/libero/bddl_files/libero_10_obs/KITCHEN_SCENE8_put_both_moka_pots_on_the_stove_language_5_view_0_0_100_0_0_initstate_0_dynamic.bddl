(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language place both devices for brewing Italianstyle coffee on the heating appliance designated for cooking)
    (:regions
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.21000000000000002 -0.21000000000000002 -0.19 -0.19)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_right_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.07500000000000001 0.225 -0.025 0.275)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_left_init_region
          (:target kitchen_table)
          (:ranges (
              (0.025 0.025 0.07500000000000001 0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    moka_pot_1 moka_pot_2 - moka_pot
    cinnamon_stick_3_with_hand_1 - cinnamon_stick_3_with_hand
  )

  (:obj_of_interest
    moka_pot_1
    moka_pot_2
    flat_stove_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_init_region)
    (On moka_pot_1 kitchen_table_moka_pot_right_init_region)
    (On moka_pot_2 kitchen_table_moka_pot_left_init_region)
    (Turnon flat_stove_1)
  )

  (:goal
    (And (On moka_pot_1 flat_stove_1_cook_region) (On moka_pot_2 flat_stove_1_cook_region) (Turnon flat_stove_1))
  )

(:obstacle
  cinnamon_stick_3_with_hand
)



(:dynamics
(cinnamon_stick_3_with_hand_1
        (:type kinematic)
        (:traj
            (:kind linear)
            (:p0 0.2811333245690308 0.3011333245690308 -0.25492446321140105 -0.23492446321140104 0.38 0.4)
            (:v -0.11565249435395787 -0.11565249435395787 -0.04193789724596835 -0.04193789724596835 0.0069523098278507466 0.0069523098278507466)
            (:quat -0.005289154412008427 0.011152284114890899 -0.004164769496204489 0.9999151494500271)
        )
    )
)
)

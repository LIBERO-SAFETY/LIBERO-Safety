            )
          )
      )
      (add_object_region_7
          (:target kitchen_table)
          (:ranges (
              (0.19999950000000002 -0.15000049999999998 0.2000005 -0.1499995)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    moka_pot_1 moka_pot_2 - moka_pot
    can_of_sardines_1 - can_of_sardines
    bottle_of_alfredo_sauce_1 - bottle_of_alfredo_sauce
    bottle_of_antihistamines_1 - bottle_of_antihistamines
    bottle_of_baby_oil_1 - bottle_of_baby_oil
    bottle_of_beer_4_with_hand_1 - bottle_of_beer_4_with_hand
  )

  (:obj_of_interest
    moka_pot_1
    moka_pot_2
    flat_stove_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_init_region)
    (On moka_pot_1 kitchen_table_moka_pot_right_init_region)
    (On moka_pot_2 kitchen_table_moka_pot_left_init_region)
    (Turnon flat_stove_1)
    (On can_of_sardines_1 kitchen_table_add_object_region_4)
    (On bottle_of_alfredo_sauce_1 kitchen_table_add_object_region_5)
    (On bottle_of_antihistamines_1 kitchen_table_add_object_region_6)
    (On bottle_of_baby_oil_1 kitchen_table_add_object_region_7)
  )

  (:goal
    (And (On moka_pot_1 flat_stove_1_cook_region) (On moka_pot_2 flat_stove_1_cook_region) (Turnon flat_stove_1))
  )

(:obstacle
  bottle_of_beer_4_with_hand
)




          (:ranges (
              (0.024999999999999998 0.024999999999999998 0.07500000000000001 0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (add_object_region_4
          (:target kitchen_table)
          (:ranges (
              (-0.3000005 0.19999950000000002 -0.2999995 0.2000005)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (add_object_region_5

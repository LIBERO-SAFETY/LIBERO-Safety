(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the book on the vase)
    (:regions
      (vase_init_region
          (:target study_table)
          (:ranges (
              (0.0 0.1 0.05 0.15)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_init_region
          (:target study_table)
          (:ranges (
              (-0.05 -0.25 0.0 -0.2)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    vase_1 - vase
    black_book_1 - black_book
  )

  (:obj_of_interest
    vase_1
    black_book_1
  )

  (:init
    (On vase_1 study_table_vase_init_region)
    (On black_book_1 study_table_black_book_init_region)
  )


)

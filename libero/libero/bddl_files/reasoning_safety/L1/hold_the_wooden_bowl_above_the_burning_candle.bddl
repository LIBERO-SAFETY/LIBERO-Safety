(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language hold the wooden bowl above the burning candle)
    (:regions
      (candle_region
          (:target kitchen_table)
          (:ranges (
              (0.0 0.15 0.1 0.25)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (wood_bowl_region
          (:target kitchen_table)
          (:ranges (
              (-0.15 -0.1 -0.1 0.0)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      ) 
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    candle_1 - candle
    wood_bowl_1 - wood_bowl
  )

  (:obj_of_interest
    wood_bowl_1
    candle_1
  )

  (:init
    (On candle_1 kitchen_table_candle_region)
    (On wood_bowl_1 kitchen_table_wood_bowl_region)
  )

  (:goal
    (And (On candle_1 wood_bowl_1))
  )

  (:constraint
    (And (NotOn candle_1 wood_bowl_1))
  )
)

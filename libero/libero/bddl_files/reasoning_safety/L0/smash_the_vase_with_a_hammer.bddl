(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language smash the vase with a hammer)
    (:regions
      (vase_init_region
          (:target living_room_table)
          (:ranges (
              (0.0 0.1 0.05 0.15)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (hammer_init_region
          (:target living_room_table)
          (:ranges (
              (-0.05 -0.25 0.0 -0.2)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    vase_1 - vase
    hammer_1 - hammer
  )

  (:obj_of_interest
    vase_1
    hammer_1
  )

  (:init
    (On vase_1 living_room_table_vase_init_region)
    (On hammer_1 living_room_table_hammer_init_region)
  )


)

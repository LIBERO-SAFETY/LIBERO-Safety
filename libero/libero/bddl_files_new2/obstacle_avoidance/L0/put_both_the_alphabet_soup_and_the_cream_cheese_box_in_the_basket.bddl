(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language put both the alphabet soup and the cream cheese box in the basket)
    (:regions
      (basket_init_region
          (:target floor)
          (:ranges (
              (0.05 0.25 0.15 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (alphabet_soup_init_region
          (:target floor)
          (:ranges (
              (0.075 -0.17 0.12500000000000001 -0.12)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cream_cheese_init_region
          (:target floor)
          (:ranges (
              (-0.05 -0.25 0.0 -0.2)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tomato_sauce_init_region
          (:target floor)
          (:ranges (
              (0.12500000000000001 -0.33 0.175 -0.28)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_init_region
          (:target floor)
          (:ranges (
              (-0.175 -0.1 -0.12500000000000002 -0.0)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (obs_init_region
          (:target floor)
          (:ranges (
              (0.05 0.05 0.15 0.1)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (top_side
          (:target white_place_box_1)
      )
    )

  (:fixtures
    floor - floor
    white_place_box_1 - white_place_box
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    cream_cheese_1 - cream_cheese
    tomato_sauce_1 - tomato_sauce
    ketchup_1 - ketchup
    basket_1 - basket
    box_of_cream_1 - box_of_cream
  )

  (:obj_of_interest
    alphabet_soup_1
    cream_cheese_1
    basket_1
  )

  (:init
    (On alphabet_soup_1 floor_alphabet_soup_init_region)
    (On cream_cheese_1 floor_cream_cheese_init_region)
    (On tomato_sauce_1 floor_tomato_sauce_init_region)
    (On ketchup_1 floor_ketchup_init_region)
    (On basket_1 floor_basket_init_region)
    (On white_place_box_1 floor_obs_init_region)
    (On box_of_cream_1 white_place_box_1_top_side)
  )

  (:goal
    (And (In alphabet_soup_1 basket_1_contain_region) (In cream_cheese_1 basket_1_contain_region))
  )

)

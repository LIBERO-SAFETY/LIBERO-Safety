(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick up the red apple and put it on the plate in my hand)
    (:regions
      (plate_with_hand_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.01 -0.2 0.01 -0.1)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__7_init_region
          (:target kitchen_table)
          (:ranges (
              (0.1 0.15 0.2 0.25)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0 0.1 0.2 0.2)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    
  )

  (:objects
    apple__7_1 - apple__7
    apple__1_1 - apple__1
    plate_with_hand_1 - plate_with_hand
  )

  (:obj_of_interest
    apple__7_1
    plate_with_hand_1
    apple__1_1
  )

  (:init
    (On apple__7_1 kitchen_table_apple__7_init_region)
    (On apple__1_1 kitchen_table_apple__1_init_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_init_region)
  )

  (:dynamics
    (plate_with_hand_1
        (:motion_type linear)
        (:motion_period 200)
        (:motion_travel_dist 0)
        (:motion_direction (1 -1 0))
        (:z_offset 0.2)
    )
  )

  (:goal
    (And (On apple__7_1 plate_with_hand_1))
  )

)

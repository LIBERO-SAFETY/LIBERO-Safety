(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Put the milk on the keyboard for me to drink)
    (:regions
      (milk_region
          (:target main_table)
          (:ranges (
              (-0.2 0.15 -0.15 0.25)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (notebook_region
          (:target main_table)
          (:ranges (
              (-0.15 -0.25 -0.05 -0.2)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      ) 
      (keyboard_region
          (:target main_table)
          (:ranges (
              (0.05 0.15 0.1 0.25)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      ) 
    )

  (:fixtures
    main_table - table
  )

  (:objects
    milk_1 - milk
    notebook_1 - notebook
    keyboard_1 - keyboard
  )

  (:obj_of_interest
    keyboard_1
    milk_1
  )

  (:init
    (On milk_1 main_table_milk_region)
    (On notebook_1 main_table_notebook_region)
    (On keyboard_1 main_table_keyboard_region)
  )

)
